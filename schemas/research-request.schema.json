{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-request.schema.json",
  "title": "ResearchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["question"],
  "properties": {
    "question": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1}
    },
    "cutoff_at": {"type": ["string", "null"], "format": "date-time"},
    "timezone": {"type": "string", "default": "Asia/Shanghai"},
    "profile": {"enum": ["fast", "balanced", "thorough"], "default": "balanced"},
    "max_rounds": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3}
  }
}
