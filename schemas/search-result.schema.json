{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-result.schema.json",
  "title": "SearchResult",
  "type": "object",
  "required": ["result_id", "engine", "query_id", "title", "url"],
  "properties": {
    "result_id": {"type": "string"},
    "engine": {"type": "string"},
    "query_id": {"type": "string"},
    "title": {"type": "string"},
    "url": {"type": "string"},
    "canonical_url": {"type": "string"},
    "snippet": {"type": "string"},
    "publisher": {"type": "string"},
    "published_at": {"type": ["string", "null"]},
    "observed_at": {"type": ["string", "null"]},
    "forecast_valid_at": {"type": ["string", "null"]},
    "retrieved_at": {"type": ["string", "null"]},
    "content": {"type": ["string", "null"]},
    "content_status": {"type": "string"},
    "source_role": {"type": "string"},
    "exclusion_reason": {"type": ["string", "null"]},
    "discovered_by": {"type": "array", "items": {"type": "string"}},
    "matched_requirement_ids": {"type": "array", "items": {"type": "string"}},
    "scores": {"type": "object", "additionalProperties": {"type": "number"}},
    "search_channel": {"type": "string"},
    "search_backend": {"type": "string"},
    "upstream_engine": {"type": "string"},
    "fetch_engine": {"type": "string"},
    "fetch_status_code": {"type": ["integer", "null"]},
    "cache_state": {"type": "string"}
  }
}
